# full Zenodo grooming set without the held-out ground-truth session (2010), features cached
# (student_scripts/prepare_training_set.py); the training pool for the pretrained classifier and
# the practice set. Only the results in data/pretrained/ are committed.
data/zenodo_no_gt_cached/

